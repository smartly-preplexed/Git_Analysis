# RepoSec executable used by the local API server.
REPOSEC_BIN=/usr/local/bin/reposec

# Local API port. Vite proxies /api to this port.
API_PORT=8787

# Comma-separated Git hosts accepted by the URL validator.
# Add a self-hosted GitLab domain here if needed.
REPOSEC_ALLOWED_GIT_HOSTS=github.com,gitlab.com

# Directory used for cloned repositories and RepoSec output.
# Defaults to ./reposec-runs
# REPOSEC_RUN_DIR=/absolute/path/to/reposec-runs
