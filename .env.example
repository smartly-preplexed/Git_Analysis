# Software Vetter shared-server settings
# Copy/export these values in your service manager or shell as needed.

# Bind to 127.0.0.1 behind Nginx/Caddy, or 0.0.0.0 for direct LAN access.
API_HOST=127.0.0.1
API_PORT=8787

# For a 4-core / 16 GB server, start with 2 parallel RepoSec scans.
MAX_CONCURRENT_SCANS=2
MAX_QUEUED_SCANS=20
ANALYSIS_TIMEOUT_MINUTES=60
JOB_RETENTION_HOURS=24

# Keep job workspaces outside the application/Vite tree.
REPOSEC_RUN_DIR=/var/tmp/software-vetter-reposec-runs

# Accepted repository hosts.
REPOSEC_ALLOWED_GIT_HOSTS=github.com,gitlab.com

# Shared mode defaults to the bundled, isolation-safe RepoSec copy.
# If you explicitly select another engine, the server limits it to one scan
# unless you assert that it honors REPOSEC_TMP_DIR/TMPDIR per job.
# REPOSEC_BIN=/usr/local/bin/reposec
# REPOSEC_PARALLEL_SAFE=1
